{
  "name": "@local/dsh-turn-recap",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Short model-written recap once a finished turn goes quiet in the DSH Web UI, plus an on-demand /recap command.",
  "license": "MIT",
  "author": "littepoint",
  "homepage": "https://github.com/littepointR/dsh-turn-recap#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/littepointR/dsh-turn-recap.git"
  },
  "bugs": {
    "url": "https://github.com/littepointR/dsh-turn-recap/issues"
  },
  "keywords": ["dsh", "deepseek-harness", "plugin", "recap", "session"],
  "scripts": {
    "test": "node test/host.test.mjs",
    "check": "node --check index.js && node --check client.js && node --check test/host.test.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-locale", "@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
